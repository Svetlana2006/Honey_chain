{
  "name": "honey-chain",
  "version": "1.0.0",
  "description": "KVIC Honey Traceability Platform — monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:api":    "npm run dev --workspace=@honey-chain/api",
    "dev:client": "npm run dev --workspace=@honey-chain/client",
    "start:api":  "npm run start --workspace=@honey-chain/api",
    "install:all": "npm install"
  }
}
